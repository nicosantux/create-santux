{
  "name": "@santux/eslint-config",
  "version": "1.0.0",
  "description": "Shared ESLint, Prettier and commitlint config for TypeScript projects.",
  "keywords": [
    "commitlint",
    "eslint",
    "eslint-config",
    "prettier"
  ],
  "license": "ISC",
  "author": {
    "name": "Nicolás Santuccio",
    "email": "nico.santuccio@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicosantux/santux.git",
    "directory": "packages/eslint-config"
  },
  "files": [
    "src",
    "!src/test",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./lint": {
      "types": "./src/lint.d.ts",
      "default": "./src/lint.js"
    },
    "./format": {
      "types": "./src/format.d.ts",
      "default": "./src/format.js"
    },
    "./format-astro": {
      "types": "./src/format-astro.d.ts",
      "default": "./src/format-astro.js"
    },
    "./format-tailwind": {
      "types": "./src/format-tailwind.d.ts",
      "default": "./src/format-tailwind.js"
    },
    "./commitlint": {
      "types": "./src/commitlint.d.ts",
      "default": "./src/commitlint.js"
    },
    "./astro": {
      "types": "./src/astro.d.ts",
      "default": "./src/astro.js"
    },
    "./astro-react": {
      "types": "./src/astro-react.d.ts",
      "default": "./src/astro-react.js"
    },
    "./next": {
      "types": "./src/next.d.ts",
      "default": "./src/next.js"
    },
    "./react-vite": {
      "types": "./src/react-vite.d.ts",
      "default": "./src/react-vite.js"
    },
    "./tanstack-start": {
      "types": "./src/tanstack-start.d.ts",
      "default": "./src/tanstack-start.js"
    },
    "./tailwind": {
      "types": "./src/tailwind.d.ts",
      "default": "./src/tailwind.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "@shadcn/lint": "0.2.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.6",
    "@shadcn/lint": "0.2.5",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript/typescript6": "6.0.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript-eslint": "8.72.2"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "@shadcn/lint": {
      "optional": true
    },
    "@typescript/typescript6": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-jsx-a11y": {
      "optional": true
    },
    "eslint-plugin-react": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-react-refresh": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "prettier-plugin-astro": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
